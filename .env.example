# Local environment for `npm run dev` (Wrangler reads `.env` or `.dev.vars`).
#   cp .env.example .env
# Never commit the real file. In production, set each value as a Cloudflare Pages secret:
#   npx wrangler pages secret put <NAME> --project-name <your-pages-project>

# Required. Signs admin session tokens. Use a long random value (e.g. `openssl rand -base64 48`).
JWT_SECRET="replace-with-a-long-random-value"

# Required. Cloudflare Turnstile secret for the contact, checkout and RSVP forms.
# The value below is Cloudflare's public always-pass test secret, for local development only.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Optional. PayMongo card checkout (currently disabled; GCash is used). Leave empty unless enabled.
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
